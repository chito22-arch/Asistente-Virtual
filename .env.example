# Copia este archivo como .env y rellena los valores. .env NO se sube a GitHub.
NOMBRE_ASISTENTE=Jarvis
# Tu ciudad, para "qué tiempo hace" sin decir dónde
CIUDAD=

# IA para frases libres: ollama (local, gratis) o ninguno
IA_PROVEEDOR=ollama
IA_MODELO=qwen3:8b
# IA_DEPURAR=1   # muestra qué herramienta elige la IA

# Modo voz
WHISPER_MODELO=small
# Micrófono (vacío = el predeterminado de Windows). Se cambia diciendo "usa el micrófono 2"
# o desde el menú del icono; Jarvis lo guarda aquí solo.
MICROFONO=
VOZ=Helena

# Fase 4 - Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
